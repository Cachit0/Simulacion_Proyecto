      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Lo hare
      modoPersonajes: 2
      personajePrincipal: {fileID: 5016831858450466051, guid: 382de72eaa1175f4d835f0e9d6232632, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -7571594904699281773, guid: d57c5a96ad580e240b6fd79ff520ec2f, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: 
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "Hoy caen cosas extra\xF1as en la caldera, \xBFMala limpieza? Ewww,
        bueno puedes deshacerte de ellas con una fusion cercana ;D"
      modoPersonajes: 0
      personajePrincipal: {fileID: 5016831858450466051, guid: 382de72eaa1175f4d835f0e9d6232632, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: -7571594904699281773, guid: d57c5a96ad580e240b6fd79ff520ec2f, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
  victoriaFinal:
    nombreEscena: Victoria
    fondoInicial: {fileID: -3552702312740951106, guid: 8039b76ce9357cb4f9d67a8d38a20bce, type: 3}
    dialogos:
    - nombrePersonaje: Maestra de Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Vaya~ No esperaba un recibimiento
      modoPersonajes: 2
      personajePrincipal: {fileID: 3364985895592556984, guid: e5537ef9710f0ae4b8877cb3bef4ba69, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: 1515110643752042935, guid: 413ffa43a7f556e4ba7c30b5ffc26fd1, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "\xA1Maestra! \xA1Maestra! Lo logre"
      modoPersonajes: 2
      personajePrincipal: {fileID: -8166165738135017309, guid: adc3513ebb592e24d8a0395890fb6f5f, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -4034764415900404906, guid: 6445552d643fdd644ae9b9e1ab317148, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Maestra de Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Sabia que podia confiar en ti cielo, bien hecho
      modoPersonajes: 2
      personajePrincipal: {fileID: 3364985895592556984, guid: e5537ef9710f0ae4b8877cb3bef4ba69, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: -9109119884054987350, guid: 47cb072869736264684e2f454e41b9dc, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Maestra de Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Ahora vamos a dentro, te traje algunos regalos~
      modoPersonajes: 2
      personajePrincipal: {fileID: 3364985895592556984, guid: e5537ef9710f0ae4b8877cb3bef4ba69, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: -9109119884054987350, guid: 47cb072869736264684e2f454e41b9dc, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "\xBFQue es? Una nueva escoba, tal vez el mitico grimorio"
      modoPersonajes: 2
      personajePrincipal: {fileID: 5016831858450466051, guid: 382de72eaa1175f4d835f0e9d6232632, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -4034764415900404906, guid: 6445552d643fdd644ae9b9e1ab317148, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Maestra de Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: No cielo~ Una bruja de verdad necesita su propia varita
      modoPersonajes: 2
      personajePrincipal: {fileID: 5016831858450466051, guid: 382de72eaa1175f4d835f0e9d6232632, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -9109119884054987350, guid: 47cb072869736264684e2f454e41b9dc, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: 
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "Good ending: \xBFUna varita? \xBFPara miiiii? :3"
      modoPersonajes: 0
      personajePrincipal: {fileID: 5016831858450466051, guid: 382de72eaa1175f4d835f0e9d6232632, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: -9109119884054987350, guid: 47cb072869736264684e2f454e41b9dc, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
  derrota:
    nombreEscena: Derrota
    fondoInicial: {fileID: -7460575803814750012, guid: 09f970f99597b4c4c8d7f28d09f52fa3, type: 3}
    dialogos:
    - nombrePersonaje: Maestra de Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "Con que aqui estabas~ \xBFQue sucede cielo?"
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: 1515110643752042935, guid: 413ffa43a7f556e4ba7c30b5ffc26fd1, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Soy una terrible aprendiz. . .
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -4034764415900404906, guid: 6445552d643fdd644ae9b9e1ab317148, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Maestra de Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Cielo... No te preocupes, yo falle almenos 10 veces la prueba de mi
        propia maestra, esta es apenas tu primera vez~
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: 1515110643752042935, guid: 413ffa43a7f556e4ba7c30b5ffc26fd1, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: . . .
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: 1515110643752042935, guid: 413ffa43a7f556e4ba7c30b5ffc26fd1, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Maestra de Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Luego habra otra oportunidad
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: 1515110643752042935, guid: 413ffa43a7f556e4ba7c30b5ffc26fd1, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Maestra de Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Si lo prefieres, la proxima vez te llevare con migo~
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: 1515110643752042935, guid: 413ffa43a7f556e4ba7c30b5ffc26fd1, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: 
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: 'Bad ending: La proxima vez~'
      modoPersonajes: 0
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: 1515110643752042935, guid: 413ffa43a7f556e4ba7c30b5ffc26fd1, type: 3}
