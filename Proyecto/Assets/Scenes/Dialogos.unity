  introNivel1:
    nombreEscena: Escena 1
    fondoInicial: {fileID: -3552702312740951106, guid: 8039b76ce9357cb4f9d67a8d38a20bce, type: 3}
    dialogos:
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "\xBFLo dice en serio?"
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -4034764415900404906, guid: 6445552d643fdd644ae9b9e1ab317148, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Maestra de Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Todos merecemos un descanso una vez cada milenio
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: 1515110643752042935, guid: 413ffa43a7f556e4ba7c30b5ffc26fd1, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Pero entonces lleveme con usted... Yo aun no estoy lista-
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -4034764415900404906, guid: 6445552d643fdd644ae9b9e1ab317148, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Maestra de Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Para nada cielo, estas mas que lista, despues de todo has aprendido
        de la mejor bruja
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: -9109119884054987350, guid: 47cb072869736264684e2f454e41b9dc, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Maestra de Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "\xA1Oh! Se hace tarde, buena suerte querida"
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: -9109119884054987350, guid: 47cb072869736264684e2f454e41b9dc, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Y- Realmente se fue...
      modoPersonajes: 1
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -9109119884054987350, guid: 47cb072869736264684e2f454e41b9dc, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Auuullidos
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "Hola se\xF1orita, vine por el encargo de las dos"
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: -7026774836311849658, guid: 0bfc6303c68133445b2e53351536d9ee, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "\xBFQ-que? Pero la se\xF1ora no dijo nada de eso... Um lo siento pero-"
      modoPersonajes: 2
      personajePrincipal: {fileID: 5016831858450466051, guid: 382de72eaa1175f4d835f0e9d6232632, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -7026774836311849658, guid: 0bfc6303c68133445b2e53351536d9ee, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Auuullidos
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "\xA1\xBFQ-que?! N-no, es importante, necesito esa pocion ni\xF1a, \xA1\xA1\xA1POR
        FAVOR!!!"
      modoPersonajes: 2
      personajePrincipal: {fileID: 3364985895592556984, guid: e5537ef9710f0ae4b8877cb3bef4ba69, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: 28142499352110981, guid: 61059f9d9d11f5047939a17dbe03cbb7, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "\xBFEh-?"
      modoPersonajes: 2
      personajePrincipal: {fileID: 5016831858450466051, guid: 382de72eaa1175f4d835f0e9d6232632, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: 28142499352110981, guid: 61059f9d9d11f5047939a17dbe03cbb7, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Auuullidos
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: 'Si no la tomo, me transformare en algo horrible, un hombre-, y y y,
        yo soy un hombre lobo, no solo un hombre '
      modoPersonajes: 2
      personajePrincipal: {fileID: 5016831858450466051, guid: 382de72eaa1175f4d835f0e9d6232632, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: 28142499352110981, guid: 61059f9d9d11f5047939a17dbe03cbb7, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "Bueno \xA1Lo intentare por usted se\xF1or hombre lobo!"
      modoPersonajes: 2
      personajePrincipal: {fileID: -8166165738135017309, guid: adc3513ebb592e24d8a0395890fb6f5f, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: 28142499352110981, guid: 61059f9d9d11f5047939a17dbe03cbb7, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
  introNivel2:
    nombreEscena: Escena 2
    fondoInicial: {fileID: 2590456727276172604, guid: 2b6a06467ae3a4645bcd1b3996fd7c18, type: 3}
    dialogos:
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Lero lero candelero
      modoPersonajes: 1
