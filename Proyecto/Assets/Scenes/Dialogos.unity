      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Pumking
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Pagare el doble
      modoPersonajes: 2
      personajePrincipal: {fileID: 3364985895592556984, guid: e5537ef9710f0ae4b8877cb3bef4ba69, type: 3}
      posicionPersonajePrincipal: 0
