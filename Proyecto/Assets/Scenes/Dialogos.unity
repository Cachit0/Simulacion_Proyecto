      imagenFondo: {fileID: 0}
    - nombrePersonaje: Buuurrito
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Uhhh~
      modoPersonajes: 2
      personajePrincipal: {fileID: 3364985895592556984, guid: e5537ef9710f0ae4b8877cb3bef4ba69, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: 2223210207600094948, guid: 7b6f197dae215f54c8fac13014a16e44, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "Buenos dias se\xF1or :D"
      modoPersonajes: 2
      personajePrincipal: {fileID: 5016831858450466051, guid: 382de72eaa1175f4d835f0e9d6232632, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: 2223210207600094948, guid: 7b6f197dae215f54c8fac13014a16e44, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Buuurrito
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Uhhh uh uhhh
      modoPersonajes: 2
      personajePrincipal: {fileID: 3364985895592556984, guid: e5537ef9710f0ae4b8877cb3bef4ba69, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -3790165558237968476, guid: ec487da18d3d9574a8d0440f2283843e, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "Pero... \xBFPor que usted necesitaria una pocion para eso-?"
      modoPersonajes: 2
      personajePrincipal: {fileID: 5016831858450466051, guid: 382de72eaa1175f4d835f0e9d6232632, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: 2223210207600094948, guid: 7b6f197dae215f54c8fac13014a16e44, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Buuurrito
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "\xA1Uhhh!... Uh uhhh uh uhh-"
      modoPersonajes: 2
      personajePrincipal: {fileID: 3364985895592556984, guid: e5537ef9710f0ae4b8877cb3bef4ba69, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: 745838420577897996, guid: 924b0b097e7e5b940a7323cdde10c4ba, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: . . .
      modoPersonajes: 2
      personajePrincipal: {fileID: 3364985895592556984, guid: e5537ef9710f0ae4b8877cb3bef4ba69, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: 745838420577897996, guid: 924b0b097e7e5b940a7323cdde10c4ba, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "Um esta bien no hare mas preguntas \xA1Y-yo me encargo se\xF1or!"
      modoPersonajes: 2
      personajePrincipal: {fileID: -8166165738135017309, guid: adc3513ebb592e24d8a0395890fb6f5f, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -3790165558237968476, guid: ec487da18d3d9574a8d0440f2283843e, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: 
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "\xBFEh? La caldera esta extra\xF1a, el agua baja y sube, si baja secara
        los elementos :C, aun que mientras se combinen volvera a subir"
      modoPersonajes: 0
      personajePrincipal: {fileID: -8166165738135017309, guid: adc3513ebb592e24d8a0395890fb6f5f, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -3790165558237968476, guid: ec487da18d3d9574a8d0440f2283843e, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
  introNivel3:
    nombreEscena: Escena 3
    fondoInicial: {fileID: 2590456727276172604, guid: 2b6a06467ae3a4645bcd1b3996fd7c18, type: 3}
    dialogos:
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Pronto volvera la maestra... Tengo miedo
      modoPersonajes: 1
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: 0}
      posicionPersonajeSecundario: 0
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Pumking
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "Buen dia ni\xF1a, necesito 200 pociones para- "
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: -7571594904699281773, guid: d57c5a96ad580e240b6fd79ff520ec2f, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "Perdon... \xBF\xA1Dijo 200?!"
      modoPersonajes: 2
      personajePrincipal: {fileID: 5016831858450466051, guid: 382de72eaa1175f4d835f0e9d6232632, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -7571594904699281773, guid: d57c5a96ad580e240b6fd79ff520ec2f, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Pumking
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Si, 200 pociones para la corte-
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: -7571594904699281773, guid: d57c5a96ad580e240b6fd79ff520ec2f, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: Imposible.
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
      personajeSecundario: {fileID: -6028082668497414077, guid: f8a54200cff82f84285835ea672e1c1d, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 0
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Pumking
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "\xBFEs demasiado? Bueno dame unas 10 con eso deberia ser suficiente
        por ahora~"
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 0
      personajeSecundario: {fileID: -6028082668497414077, guid: f8a54200cff82f84285835ea672e1c1d, type: 3}
      posicionPersonajeSecundario: 2
      secundarioHabla: 1
      imagenFondo: {fileID: 0}
    - nombrePersonaje: Sabrina
      colorNombre: {r: 0, g: 0, b: 0, a: 0}
      texto: "No creo que pueda se\xF1or-"
      modoPersonajes: 2
      personajePrincipal: {fileID: 5901811912047597420, guid: c99a7bbe7c9f51943a014ccfaa8184e9, type: 3}
      posicionPersonajePrincipal: 0
      principalHabla: 1
